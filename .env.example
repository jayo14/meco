# ==============================================================================
# MECO CONFIGURATION TEMPLATE (PHASE 9 PRODUCTION READY)
# ==============================================================================
# Instructions: Copy this file to .env and set your deployment parameters.
# Never commit .env or expose credentials, private keys, or API tokens.
# ==============================================================================

# --- Application Core ---
APP_NAME=meco
APP_ENV=production
LOG_LEVEL=INFO

# --- Database & Connection Pooling ---
# Localhost PostgreSQL connection URI (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/meco
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30.0
DB_POOL_PRE_PING=true

# --- Solana RPC & WebSocket Feeds ---
# Public or private dedicated Solana RPC endpoint (e.g. Helius, QuickNode, Triton)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# --- Real-Time PumpPortal Feed ---
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
ENABLE_PUMPPORTAL_DISCOVERY=true
ENABLE_SOLANA_RPC_DISCOVERY=true
DISCOVERY_WS_HEARTBEAT_INTERVAL=30.0
DISCOVERY_RECONNECT_MIN_DELAY=1.0
DISCOVERY_RECONNECT_MAX_DELAY=60.0

# --- Telegram Ingestion & MTProto Client ---
# Obtain your API ID and Hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=meco
# Comma-separated list of target channel IDs (optional filter)
TELEGRAM_CHANNELS=

# --- Social Intelligence Sources ---
ENABLE_RSS_SOCIAL=true
ENABLE_TELEGRAM_SOCIAL=true
ENABLE_X_SOCIAL=false
X_API_BEARER_TOKEN=
RSS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/,https://decrypt.co/feed
SOCIAL_POLL_INTERVAL=60.0

# --- Dashboard API & Security Guards ---
API_HOST=0.0.0.0
API_PORT=8000
# Optional bearer token for operator control endpoints (leave empty for dev loopback)
API_AUTH_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
