[Unit]
Description=Meco Autonomous Intelligence & Discovery Daemon (Phase 9 Hardened)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=meco
Group=meco
WorkingDirectory=/home/meco/meco
EnvironmentFile=/home/meco/meco/.env
ExecStart=/home/meco/meco/.venv/bin/python -m app.runner
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s

# Sandboxing and resource isolation
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/meco/meco /home/meco/meco/backups
LimitNOFILE=65535

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meco

[Install]
WantedBy=multi-user.target
